# ════════════════════════════════════════════════════════════════════
# Omni ERP — Environment Variables
# Copy to .env and fill in the values before running.
# ════════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL via Docker) ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omni_erp

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_use_python_c_import_secrets_print_secrets_token_hex_64
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Trust Network HMAC pepper (app.modules.trust.services.hashing). Mixed
# into every phone-number hash before it's persisted — generate with the
# same command as SECRET_KEY and keep it out of source control.
TRUST_PEPPER=CHANGE_ME_use_python_c_import_secrets_print_secrets_token_hex_64

# ── App ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── EventBus ──────────────────────────────────────────────────────────
# "memory" for dev/test, "redis" for production
EVENT_BUS_BACKEND=memory

# ── AI Bot (app.core.ai.adapter + /api/v1/ai/ask) ───────────────────────
# Any OpenAI-compatible /chat/completions endpoint. Leave AI_API_KEY unset
# to leave the AI Bot disabled (it fails with a clear Arabic message
# instead of crashing). To try it for free with Groq: create a key at
# https://console.groq.com/keys and paste it below — no code change
# needed. To switch to OpenAI later: set AI_BASE_URL=https://api.openai.com/v1,
# AI_MODEL to a real OpenAI model, and AI_API_KEY to an OpenAI key.
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
