# ════════════════════════════════════════════════════════════════════
# Omni ERP — Environment Variables
# Copy to .env and fill in the values before running.
# ════════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL via Docker) ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omni_erp

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_use_python_c_import_secrets_print_secrets_token_hex_64
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── EventBus ──────────────────────────────────────────────────────────
# "memory" for dev/test, "redis" for production
EVENT_BUS_BACKEND=memory
